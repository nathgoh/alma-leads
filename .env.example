# Copy to .env (gitignored). Values here are for LOCAL DEVELOPMENT ONLY.
# URLs below are host-side (tools run on your machine); docker-compose.yml overrides the
# hostnames that differ inside the container network (postgres, minio, mailpit, api).

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alma
POSTGRES_HOST_PORT=5432
# One URL for Prisma (as-is) and SQLAlchemy (rewritten to postgresql+asyncpg://).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alma
# Prisma shadow DB — wiped on every use. Never point this at real data.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alma_shadow
# pytest resets this DB on every run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alma_test

# --- Auth -------------------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef
# __Host-session in production (requires HTTPS)
SESSION_COOKIE_NAME=session
# true in production
COOKIE_SECURE=false
# Exact-match origins allowed to send POST/PUT/PATCH/DELETE. :8000 is Swagger UI (local only).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# password for seeded attorney accounts (local only)
SEED_PASSWORD=password123

# --- Object storage (MinIO locally, S3 in prod) ------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-local-only
MAX_RESUME_BYTES=5242880

# --- Email ------------------------------------------------------------------
# smtp (Mailpit) | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=Alma Leads <no-reply@alma.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
ATTORNEY_EMAILS=attorney@example.com
WEB_BASE_URL=http://localhost:3000

# --- Web --------------------------------------------------------------------
# Where NextJS reaches FastAPI (rewrite target + server-component fetches).
# docker-compose overrides this to http://api:8000.
API_INTERNAL_URL=http://localhost:8000
