# One-shot migration image: Node + the locked Prisma 7 CLI. Never part of the API runtime.
FROM node:22-slim
# Prisma's schema engine needs OpenSSL, which node:*-slim doesn't ship.
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /migrate
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY prisma.config.ts ./
COPY prisma ./prisma
USER node
CMD ["npx", "prisma", "migrate", "deploy"]
